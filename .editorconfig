# EditorConfig is awesome: https://EditorConfig.org
# Keeps indentation / line endings consistent across editors.

root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{html,css,js,vbs}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[*.vbs]
end_of_line = crlf